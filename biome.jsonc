{
	"$schema": "https://biomejs.dev/schemas/2.4.1/schema.json",
	"formatter": {
		"enabled": true,
		"lineWidth": 120
	},
	"linter": {
		"rules": {
			"performance": {
				"noImgElement": "off" // Not important at the moment, address this later. Probably.
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							["react", "react-dom"],
							":NODE:",
							":BLANK_LINE:",
							":PACKAGE:",
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	},
	"files": {
		"includes": ["client/**/*.{ts,tsx,js,jsx,json}", "server/**/*.{ts,tsx,js,json}", "!!**/.next"]
	}
}
