{
	"formatter": {
		"enabled": true,
		"lineWidth": 120
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							["react", "react-dom"],
							":NODE:",
							":BLANK_LINE:",
							":PACKAGE:",
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	},
	"files": {
		"includes": ["client/**/*.{ts,tsx,js,jsx,json}", "server/**/*.{ts,tsx,js,json}", "!!**/.next"]
	}
}
