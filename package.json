{
  "name": "s3-image-upload-thing",
  "private": true,
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "cd server && bun run dev",
    "format": "biome check --write --linter-enabled=false client/ server/",
    "lint": "biome lint",
    "lint:fix": "biome lint --write client/ server/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.1",
    "concurrently": "^9.1.2"
  }
}
